{
  "expo": {
    "name": "NFC-CERTIFICADOS",
    "slug": "NFC-CERTIFICADOS",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "nfccertificados",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.TurijanMedia.nfccertificados",
      "icon": "./assets/expo.icon",
      "infoPlist": {
        "UIRequiredDeviceCapabilities": [
          "arm64"
        ]
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.NFC"
      ]
    },
    "web": {
      "output": "server",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "react-native-nfc-manager",
        {
          "nfcPermission": "NFC se usa para escribir enlaces de certificados en etiquetas cercanas."
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "edda28fc-77ab-4daa-b073-e0c54218600c"
      }
    }
  }
}
